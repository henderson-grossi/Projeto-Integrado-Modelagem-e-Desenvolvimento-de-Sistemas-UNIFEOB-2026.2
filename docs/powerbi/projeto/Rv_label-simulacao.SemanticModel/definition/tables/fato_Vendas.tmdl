table fato_Vendas
	lineageTag: bf4a1135-fa47-465e-9de0-3437209b240d

	measure 'Pedidos Entregues' = CALCULATE([Pedidos], fato_Vendas[Status_Pedido] = "Entregue")
		formatString: 0

	measure 'Itens Vendidos' = CALCULATE(SUM(fato_Vendas[Quantidade]), fato_Vendas[Status_Pedido] = "Entregue")
		formatString: #,0

	measure 'Clientes Ativos' = CALCULATE(DISTINCTCOUNT(fato_Vendas[ID_Cliente]), fato_Vendas[Status_Pedido] = "Entregue")
		formatString: 0

	measure 'Pedidos por Cliente' = DIVIDE([Pedidos Entregues], [Clientes Ativos])
		formatString: 0.0

	measure 'Desconto Concedido' = CALCULATE(SUM(fato_Vendas[Valor_Desconto]), fato_Vendas[Status_Pedido] = "Entregue")
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00

	measure 'Taxa de Cancelamento' = DIVIDE(CALCULATE(COUNTROWS(fato_Vendas), fato_Vendas[Status_Pedido] = "Cancelado"), COUNTROWS(fato_Vendas))
		formatString: 0.0%;-0.0%;0.0%

	measure '% Acumulado' = VAR f = [Faturamento] VAR tot = CALCULATE([Faturamento], ALLSELECTED(dim_Produtos)) RETURN IF(NOT ISBLANK(f), DIVIDE(SUMX(FILTER(ALLSELECTED(dim_Produtos), [Faturamento] >= f), [Faturamento]), tot))
		formatString: 0.0%;-0.0%;0.0%

	measure 'Classe ABC' = VAR p = [% Acumulado] RETURN IF(ISBLANK(p), BLANK(), IF(p <= 0.8, "A", IF(p <= 0.95, "B", "C")))

	measure 'Peças Classe A' = COUNTROWS(FILTER(ALLSELECTED(dim_Produtos), [Classe ABC] = "A")) + 0
		formatString: 0

	measure 'Clientes Novos' = VAR ini = MIN(dim_Calendario[Data]) RETURN COUNTROWS(FILTER(CALCULATETABLE(VALUES(fato_Vendas[ID_Cliente]), fato_Vendas[Status_Pedido] = "Entregue"), CALCULATE(MIN(fato_Vendas[Data]), ALL(dim_Calendario), fato_Vendas[Status_Pedido] = "Entregue") >= ini)) + 0
		formatString: 0

	measure 'Clientes Recorrentes' = [Clientes Ativos] - [Clientes Novos]
		formatString: 0

	measure '% Recorrentes' = DIVIDE([Clientes Recorrentes], [Clientes Ativos])
		formatString: 0.0%;-0.0%;0.0%

	measure '% Recompra' = DIVIDE(COUNTROWS(FILTER(CALCULATETABLE(VALUES(fato_Vendas[ID_Cliente]), fato_Vendas[Status_Pedido] = "Entregue"), CALCULATE([Pedidos Entregues]) >= 2)), [Clientes Ativos])
		formatString: 0.0%;-0.0%;0.0%

	measure 'Última Compra' = CALCULATE(MAX(fato_Vendas[Data]), ALL(dim_Calendario), fato_Vendas[Status_Pedido] = "Entregue")
		formatString: dd/mm/yyyy

	measure 'Dias sem Comprar' = VAR u = [Última Compra] RETURN IF(NOT ISBLANK(u), DATEDIFF(u, CALCULATE(MAX(fato_Vendas[Data]), ALL(fato_Vendas)), DAY))
		formatString: 0

	measure 'Clientes a Reativar' = COUNTROWS(FILTER(VALUES(dim_Clientes[ID_Cliente]), [Dias sem Comprar] >= 90)) + 0
		formatString: 0

	measure 'Última Compra (reativar)' = IF([Dias sem Comprar] >= 90, [Última Compra])
		formatString: dd/mm/yyyy

	measure 'Dias sem Comprar (reativar)' = IF([Dias sem Comprar] >= 90, [Dias sem Comprar])
		formatString: 0

	measure 'Gasto Total (reativar)' = IF([Dias sem Comprar] >= 90, CALCULATE([Faturamento], ALL(dim_Calendario)))
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00

	measure Faturamento = CALCULATE(SUM(fato_Vendas[Valor_Liquido]), fato_Vendas[Status_Pedido] = "Entregue")
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 1ad86c7b-269e-4be7-ab59-4061ca923032

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Lucro Total' = CALCULATE(SUM(fato_Vendas[Lucro]), fato_Vendas[Status_Pedido] = "Entregue")
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: e1bafd7b-e721-4672-8a00-ed8d2e1b8110

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure Pedidos = DISTINCTCOUNT(fato_Vendas[ID_Pedido])
		formatString: 0
		lineageTag: d28754b4-8f4f-43c1-a957-625593d837d0

	measure 'Atingimento da Meta %' = DIVIDE([Faturamento], SUM(fato_Metas[Meta_Faturamento]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 22d6e272-4e8e-4c08-a632-4a35034bd006

	measure 'Crescimento Mensal %' = DIVIDE([Faturamento] - [Faturamento Mês Anterior], [Faturamento Mês Anterior])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 07ce70cf-cc93-44a8-99be-2051bfc06419

	measure 'Faturamento Mês Anterior' = CALCULATE([Faturamento], DATEADD(dim_Calendario[Data], -1, MONTH))
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: ed6feab4-5e23-4df4-b2a6-b45a5fb18a01

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Taxa de Devolução' = DIVIDE(CALCULATE(COUNTROWS(fato_Vendas), fato_Vendas[Status_Pedido] = "Devolvido"), COUNTROWS(fato_Vendas))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e5ec09b5-19d6-4ef6-b573-3985bcfac388

	measure 'Ticket Médio' = DIVIDE([Faturamento], CALCULATE([Pedidos], fato_Vendas[Status_Pedido] = "Entregue"))
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 4d3658ad-8dde-4090-8d2a-4fdbda8ca1e4

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Margem %' = DIVIDE([Lucro Total], [Faturamento])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: df628e04-8695-44d5-9206-fe22a1163820

