table fato_Estoque
	lineageTag: 78809ee8-353a-42d6-8b43-8c881604532c

	measure 'Valor em Estoque' = CALCULATE(SUM(fato_Estoque[Valor_Estoque_Final]), LASTNONBLANK(dim_Calendario[Data], CALCULATE(COUNTROWS(fato_Estoque))))
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: c8e55707-f191-489d-b1f2-7de4255728b7

	measure 'Entradas (un.)' = SUM(fato_Estoque[Entradas])
		formatString: #,0
		lineageTag: d84416ad-4dec-40c9-85d0-e293b228c5c6

	measure 'Saídas (un.)' = SUM(fato_Estoque[Saidas])
		formatString: #,0
		lineageTag: 46661e0a-7840-4edf-acc3-9f3b4bcf2317

	measure 'SKUs em Atenção' = CALCULATE(COUNTROWS(fato_Estoque), fato_Estoque[Status_Estoque] <> "OK", LASTNONBLANK(dim_Calendario[Data], CALCULATE(COUNTROWS(fato_Estoque)))) + 0
		formatString: 0
		lineageTag: a937f2db-ea0a-4e72-aada-46733fdb7613

	measure 'Estoque Mínimo' = CALCULATE(SUM(fato_Estoque[Estoque_Minimo]), LASTNONBLANK(dim_Calendario[Data], CALCULATE(COUNTROWS(fato_Estoque))))
		formatString: 0
		lineageTag: 6ee8c64e-aaac-4716-9ea4-348aeaedcf3a

	measure Situação = VAR e = [Estoque Final] VAR m = [Estoque Mínimo] RETURN IF(ISBLANK(e), BLANK(), IF(e < m, "Abaixo do mínimo", IF(e <= 2 * m, "Atenção", "OK")))
		lineageTag: bdf07226-0a93-4164-883f-14284a90a514

	measure 'Estoque Final' = CALCULATE(SUM(fato_Estoque[Estoque_Final]), LASTNONBLANK(dim_Calendario[Data], CALCULATE(COUNTROWS(fato_Estoque))))
		formatString: 0
		lineageTag: 8e6de693-5c9a-4e1c-995c-e723bcb5a397

