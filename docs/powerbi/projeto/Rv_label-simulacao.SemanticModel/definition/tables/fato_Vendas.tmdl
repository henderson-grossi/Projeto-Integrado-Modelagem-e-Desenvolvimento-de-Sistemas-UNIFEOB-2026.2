	partition fato_Vendas = m
		mode: import
		source =
				let
				    Fonte = MySQL.Database(Servidor, Banco, [ReturnSingleDatabase=true]),
				    fato_Vendas_Table = Fonte{[Schema=Banco,Item="bi_vendas"]}[Data],
				    #"Tipo Alterado" = Table.TransformColumnTypes(fato_Vendas_Table,{{"ID_Venda", type text}, {"ID_Pedido", type text}, {"Data", type date}, {"ID_Cliente", type text}, {"ID_Produto", type text}, {"ID_Vendedor", type text}, {"Canal_Venda", type text}, {"Forma_Pagamento", type text}, {"Parcelas", Int64.Type}, {"Status_Pedido", type text}, {"Quantidade", Int64.Type}, {"Preco_Unitario", Currency.Type}, {"Desconto_Perc", Percentage.Type}, {"Custo_Unitario", Currency.Type}, {"Valor_Bruto", Currency.Type}, {"Valor_Desconto", Currency.Type}, {"Valor_Liquido", Currency.Type}, {"Custo_Total", Currency.Type}, {"Lucro", Currency.Type}}),
				    #"Desconto Nulo Substituído" = Table.ReplaceValue(#"Tipo Alterado", null, 0, Replacer.ReplaceValue, {"Desconto_Perc", "Valor_Desconto"}),
				    #"Texto Aparado" = Table.TransformColumns(#"Desconto Nulo Substituído",{{"Canal_Venda", each Text.Trim(_), type text}, {"Forma_Pagamento", each Text.Trim(_), type text}, {"Status_Pedido", each Text.Trim(_), type text}}),
				    #"Linhas Inválidas Removidas" = Table.SelectRows(#"Texto Aparado", each [Data] <> null and [ID_Produto] <> null and [Quantidade] <> null and [Quantidade] > 0),
				    #"Tipo de Pagamento Adicionado" = Table.AddColumn(#"Linhas Inválidas Removidas", "Tipo_Pagamento", each if [Parcelas] <> null and [Parcelas] > 1 then "Parcelado" else "À vista", type text),
				    #"Faixa de Desconto Adicionada" = Table.AddColumn(#"Tipo de Pagamento Adicionado", "Faixa_Desconto", each if [Desconto_Perc] = 0 then "Sem desconto" else if [Desconto_Perc] <= 0.1 then "Até 10%" else "Acima de 10%", type text),
				    #"Margem do Item Adicionada" = Table.AddColumn(#"Faixa de Desconto Adicionada", "Margem_Item_Perc", each try (if [Valor_Liquido] = null or [Valor_Liquido] = 0 then null else Number.Round([Lucro] / [Valor_Liquido], 4)) otherwise null, Percentage.Type)
				in
				    #"Margem do Item Adicionada"

