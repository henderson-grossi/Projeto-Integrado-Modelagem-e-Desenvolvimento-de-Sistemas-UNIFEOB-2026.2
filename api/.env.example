DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Rv_Label
# Só para banco hospedado com TLS (Aiven): o conteúdo do ca.pem. Vazio = conexão local sem TLS.
DB_SSL_CA=
PORT=3000

# Sites que podem chamar a API pelo navegador, separados por vírgula (ex.: https://meusite.com).
# Vazio = aberto em desenvolvimento; ao hospedar, preencha e use NODE_ENV=production.
CORS_ORIGIN=
NODE_ENV=development

# Atrás de um proxy ou hospedagem (Render, Railway, Nginx...): quantos proxies ficam entre o cliente e a API, em geral 1.
# Sem isso os limites de requisição contam o IP do proxy. Valor maior que o real deixa o cliente forjar o IP.
TRUST_PROXY=

# Backup (npm run backup): quantos arquivos guardar e, se o mysqldump não estiver no PATH, o caminho dele.
BACKUP_MANTER=14
MYSQLDUMP=

JWT_SECRET=troque-por-um-texto-aleatorio-com-48+-caracteres

# Usuário só de leitura do dashboard (Power BI): enxerga apenas as views bi_*. A API não usa; fica aqui só para
# guardar a senha fora do git. Como criar: docs/powerbi/README.md.
POWERBI_DB_USER=powerbi_leitura
POWERBI_DB_PASSWORD=
